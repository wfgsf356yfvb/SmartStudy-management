# Flask Secret Key for Sessions
SECRET_KEY=<generate-a-random-32-character-secret>

# GMail SMTP Settings for OTP/Mails
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Database Configuration (Optional, defaults to SQLite playschool.db)
# For SQLite deployments, this codebase handles it automatically.

# MySQL / Database (example)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=<non-root-application-user>
MYSQL_PASSWORD=<inject-outside-the-repository>
MYSQL_DB=playschool_db

# Dedicated grant-only account; inject only into the provisioning worker.
TENANT_GRANT_MYSQL_USER=<non-root-grant-only-account>
TENANT_GRANT_MYSQL_PASSWORD=<inject-outside-the-repository>

# Tenant DB user host policy. Use the exact private Docker/VPC subnet pattern,
# for example 172.20.%, never a global wildcard.
TENANT_DB_USER_HOST=<private-docker-subnet-pattern>

# Secrets storage
# Production must explicitly select environment, protected_file, or aws.
TENANT_CREDENTIAL_PROVIDER=<environment-or-protected_file-or-aws>
TENANT_DB_CREDENTIALS_FILE=<protected-path-when-using-protected_file>

# Celery / Redis
# Production must use a real authenticated Redis broker; eager mode is test-only.
CELERY_EAGER=0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND are injected outside the repository.
