# Flask Secret Key for Sessions
SECRET_KEY=playschool_super_secret_key_2026

# GMail SMTP Settings for OTP/Mails
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Database Configuration (Optional, defaults to SQLite playschool.db)
# For SQLite deployments, this codebase handles it automatically.

# MySQL / Database (example)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=playschool_db

# Tenant DB user host constraint (override default): 'localhost' or '%'
#TENANT_DB_USER_HOST=localhost

# Secrets storage
# Set to 1 in production to store tenant creds in AWS Secrets Manager
USE_AWS_SECRETS=0

# Celery / Redis
# For development, set CELERY_EAGER=1 to run tasks in-process without Redis
CELERY_EAGER=1
# For production, configure a Redis broker:
#CELERY_BROKER_URL=redis://redis:6379/0
#CELERY_RESULT_BACKEND=redis://redis:6379/0
